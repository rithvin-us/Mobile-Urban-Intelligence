# Google Maps JavaScript API Key (Required for map rendering)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# PostgreSQL / PostGIS Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urban_intelligence

# Redis URL (Optional / Architecture ready)
REDIS_URL=redis://localhost:6379/0

# Backend API Base URL for Next.js frontend and Simulator
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
