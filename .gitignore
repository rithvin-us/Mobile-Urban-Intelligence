# Evidence frames written by the API at runtime. The directory itself is kept
# so the static mount exists in a fresh container.
apps/api/app/static/evidence/*
!apps/api/app/static/evidence/.gitkeep

# Edge store-and-forward buffers
edge_buffer_*.db

# Generated MATLAB simulation artefacts (figures, JSON payloads)
matlab sims/output/

# MATLAB / Simulink build caches and autosaves. The .slx models themselves are
# tracked; these are regenerated artefacts.
slprj/
*.slxc
*.asv
*.autosave
*.slx.r*

# Additional virtualenv layouts
.venv*/
